{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "postinstall": "node tools/patch-abbrlink.js",
    "build": "hexo clean && hexo generate",
    "test": "node --test tools/test-site-behavior.js",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "server": "hexo server",
    "dev": "hexo s",
    "dev:debug": "hexo s --debug",
    "page": "hexo new page",
    "post": "hexo new post",
    "draft": "hexo new draft",
    "cm": "git add . && git commit -m",
    "dp": "git push -v",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "infini:dev": "SITE=infini vitepress dev docs",
    "infini:build": "SITE=infini vitepress build docs",
    "infini:preview": "SITE=infini vitepress preview docs"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "hexo": "^8.1.2",
    "hexo-abbrlink": "^2.2.1",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-feed": "^3.0.0",
    "hexo-generator-index": "^3.0.0",
    "hexo-generator-searchdb": "^1.5.0",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^6.2.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-theme-butterfly": "github:jerryc127/hexo-theme-butterfly#5.7.0",
    "hexo-util": "4.0.0",
    "hexo-wordcount": "^6.0.1",
    "katex": "0.18.1"
  },
  "devDependencies": {
    "hexo-filter-nofollow": "^2.0.2",
    "hexo-generator-robotstxt": "^0.2.0",
    "hexo-minify": "^1.8.1",
    "hexo-server": "^3.0.0",
    "vitepress": "^1.6.4"
  }
}
